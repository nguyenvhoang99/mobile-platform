{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/schemas/miniapp-manifest.json",
  "title": "Mini-app manifest — single source for authoring and validation (C9)",
  "description": "This file IS the validator. Published docs and pipeline import it directly; no copy.",
  "type": "object",
  "required": ["id", "name", "shortName", "version", "routes", "rootRoute", "publicEntrypoints", "crossAppLinks", "trackingEvents"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "description": "Stable store-minted appId. Host origin is derived from this."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "englishName": { "type": "string", "maxLength": 40 },
    "shortName": { "type": "string", "minLength": 1, "maxLength": 16 },
    "glyph": { "type": "string", "minLength": 1, "maxLength": 4 },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic machine version. Never decreases; rollback is a roll-forward."
    },
    "versionName": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Human semver for display. Machines use version."
    },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^/[^\\s]*$" }
    },
    "rootRoute": { "type": "string", "pattern": "^/[^\\s]*$" },
    "resourceEndpoint": {
      "type": "string",
      "format": "uri",
      "description": "Where the signed package was fetched (for reference only)."
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "version", "purposeKey"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+\\.[a-zA-Z0-9_]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "purposeKey": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["once", "while_using", "session", "persistent"] }
        }
      }
    },
    "egressHosts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$",
        "description": "Exact host, no wildcards, no scheme, no path."
      }
    },
    "publicEntrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "allowedSources", "allowedInputKeys"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/[^\\s]*$" },
          "allowedSources": { "type": "array", "items": { "type": "string" } },
          "allowedInputKeys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "crossAppLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "targetAppId", "targetEntrypoint", "allowedInputKeys"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "targetAppId": { "type": "string" },
          "targetEntrypoint": { "type": "string" },
          "allowedInputKeys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "trackingEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "priority", "allowedDataKeys"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "priority": { "type": "string", "enum": ["critical", "operational", "product", "diagnostic"] },
          "allowedDataKeys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "minWebViewVersion": { "type": "integer", "minimum": 1 },
    "defaultLocale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "supportedLocales": { "type": "array", "items": { "type": "string" } }
  }
}
