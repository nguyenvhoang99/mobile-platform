source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# The host has Ruby 2.6. Newer ActiveSupport releases resolve connection_pool
# 3.x, which requires Ruby 3.2. Keep the CocoaPods toolchain on the last
# Ruby-2.6-compatible release family until the host Ruby is upgraded.
gem 'cocoapods', '~> 1.15.2'
gem 'activesupport', '~> 6.1.7'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
