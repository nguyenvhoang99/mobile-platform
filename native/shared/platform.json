{
  "schemaVersion": 1,
  "config": {
    "tracking": {
      "hostAppVersion": "0.0.1",
      "consentVersion": 1,
      "grpcEnabled": false,
      "maxEventBytes": 16384,
      "maxQueueBytes": 8388608,
      "maxBatchBytes": 524288,
      "cellularBatchBytes": 262144,
      "maxBatchEvents": 200,
      "maxWaitMs": {
        "critical": 1000,
        "operational": 5000,
        "product": 30000,
        "diagnostic": 300000
      },
      "retentionMs": {
        "critical": 604800000,
        "operational": 259200000,
        "product": 86400000,
        "diagnostic": 3600000
      },
      "sessionRenewMs": 1800000
    },
    "notification": {
      "hostAppVersion": "0.0.1",
      "maxInboxItems": 250,
      "maxSeenIdsPerEvent": 50,
      "reminderLeadMs": 3600000
    },
    "cards": {
      "refreshIntervalMs": 86400000
    }
  },
